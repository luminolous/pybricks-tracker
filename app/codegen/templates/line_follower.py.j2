{% extends "_base.py.j2" %}
{% block control %}
# Line follower: PD on reflection around the calibrated edge, pivot in place
# on black, search when white lasts too long, stop for obstacles.

BLACK = {{ calibration.black }}
WHITE = {{ calibration.white }}
EDGE = {{ calibration.edge }}
PIVOT_BELOW = BLACK + (WHITE - BLACK) // 8  # fully on black: sharp corner
LOST_ABOVE = WHITE - (WHITE - BLACK) // 8  # fully on white
PIVOT_RATE = 120  # deg/s
LOST_MS = 300  # white this long means the line is gone
SEARCH_RATE = 90  # deg/s
SEARCH_MS = 1200  # first sweep; the return sweep lasts twice as long

_last_error = 0
_last_turn_sign = 1
_white_timer = StopWatch()
_search_timer = StopWatch()
_search_phase = 0  # 0 following, 1 first sweep, 2 return sweep
_search_dir = 1
_obstacle = False


def setup():
    global STATE
    STATE = "FOLLOW"
    _white_timer.reset()


def start_search():
    global STATE, STEER, _search_phase, _search_dir
    _search_phase = 1
    _search_dir = _last_turn_sign
    _search_timer.reset()
    STATE = "SEARCH"
    STEER = SEARCH_RATE * _search_dir
    emit_e("LOST")


def search_step(refl):
    global STATE, STEER, STOPPED, _search_phase, _search_dir
    if refl < LOST_ABOVE:
        _search_phase = 0
        _white_timer.reset()
        STATE = "FOLLOW"
        emit_e("FOUND")
        return
    limit = SEARCH_MS if _search_phase == 1 else 2 * SEARCH_MS
    if _search_timer.time() > limit:
        if _search_phase == 1:
            _search_phase = 2
            _search_dir = -_search_dir
            _search_timer.reset()
        else:
            robot.stop()
            STEER = 0
            STATE = "STOP"
            emit_e("GIVEUP")
            STOPPED = True
            return
    STEER = SEARCH_RATE * _search_dir
    robot.drive(0, STEER)


def control_step(n, refl):
    global STATE, STEER, _last_error, _last_turn_sign, _obstacle
{% if distance %}
    if _distance_mm < OBSTACLE_MM:
        if not _obstacle:
            _obstacle = True
            emit_e("OBS", _distance_mm)
        robot.stop()
        STEER = 0
        STATE = "OBSTACLE"
        return
    if _obstacle:
        _obstacle = False
        STATE = "FOLLOW"
{% endif %}
    if _search_phase:
        search_step(refl)
        return

    error = refl - EDGE
    if refl < LOST_ABOVE:
        _white_timer.reset()
    elif _white_timer.time() > LOST_MS:
        start_search()
        return

    if refl <= PIVOT_BELOW:
        STEER = PIVOT_RATE if KP * error > 0 else -PIVOT_RATE
        STATE = "PIVOT"
        robot.drive(0, STEER)
    else:
        STEER = KP * error + KD * (error - _last_error)
        STATE = "FOLLOW"
        robot.drive(BASE_SPEED, STEER)
    _last_error = error
    if STEER > 0:
        _last_turn_sign = 1
    elif STEER < 0:
        _last_turn_sign = -1
{% endblock %}
