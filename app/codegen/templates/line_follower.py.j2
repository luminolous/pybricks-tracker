{% extends "_base.py.j2" %}
{% block control %}
# Line follower, ported from the original hand-written script: PD on
# reflection around the calibrated edge, pivot in place on black, and when
# white lasts too long, back up and sweep for the line by angle, first
# toward the correction, then twice as far the other way. Calibration and the
# live check moved to the app. Blocking moves became steps of the base loop,
# so commands, the watchdog and telemetry keep running during a search.

from pybricks.parameters import Color

BLACK = {{ calibration.black }}
WHITE = {{ calibration.white }}
EDGE = {{ calibration.edge }}
BLACK_BELOW = (BLACK + EDGE) // 2  # original: nilai < (hitam + TEPI) / 2
WHITE_ABOVE = (WHITE + EDGE) // 2  # original: nilai > (putih + TEPI) / 2
# Turn rates follow the live BASE_SPEED (SPD), so one slider sets the pace of
# every state. Original: 180 deg/s pivot, 150 deg/s search at 50 mm/s.
PIVOT_PER_MM = {{ pivot_per_mm }}
SEARCH_PER_MM = {{ search_per_mm }}
MAX_TURN = {{ max_turn }}
LOST_MS = 150  # white this long means the line is gone (90 degree corner)
SEARCH_DEG = 120  # first sweep; the return sweep covers twice this
BACKUP_MM = 20  # back up before sweeping

_last_error = 0
_white_timer = StopWatch()
_search = 0  # 0 following, 1 backing up, 2 first sweep, 3 return sweep
_search_dir = 1
_sweep_start = 0
_obstacle = False
_light = None


def turn_rate(per_mm):
    return min(MAX_TURN, abs(BASE_SPEED) * per_mm)


def light(color):
    # Hub light per state, as in the original; only touched on change.
    global _light
    if color != _light:
        hub.light.on(color)
        _light = color


def correction_dir(error):
    # Turn direction of the correction; follows the sign of KP.
    return 1 if KP * error > 0 else -1


def setup():
    global STATE
    STATE = "FOLLOW"
    _white_timer.reset()


def start_search(error):
    global STATE, STEER, _search, _search_dir
    robot.stop()
    _search_dir = correction_dir(error)
    _search = 1
    STATE = "SEARCH"
    STEER = 0
    light(Color.BLUE)
    emit_e("LOST")
    robot.straight(-BACKUP_MM, wait=False)


def search_step(refl):
    global STATE, STEER, STOPPED, _search, _search_dir, _sweep_start, _last_error
    if _search == 1:
        if robot.done():
            _search = 2
            _sweep_start = robot.angle()
        return
    if refl < EDGE:
        robot.stop()
        _search = 0
        _last_error = 0
        _white_timer.reset()
        STATE = "FOLLOW"
        emit_e("FOUND")
        return
    limit = SEARCH_DEG if _search == 2 else 2 * SEARCH_DEG
    if abs(robot.angle() - _sweep_start) >= limit:
        robot.stop()
        if _search == 2:
            _search = 3
            _search_dir = -_search_dir
            _sweep_start = robot.angle()
        else:
            STEER = 0
            STATE = "STOP"
            emit_e("GIVEUP")
            hub.speaker.beep(400, 500)
            STOPPED = True
            return
    STEER = _search_dir * turn_rate(SEARCH_PER_MM)
    robot.drive(0, STEER)


def control_step(n, refl):
    global STATE, STEER, _last_error, _obstacle
{% if distance %}
    if _distance_mm < OBSTACLE_MM:
        if not _obstacle:
            _obstacle = True
            emit_e("OBS", _distance_mm)
            light(Color.MAGENTA)
            hub.speaker.beep(1000, 100)
        robot.stop()
        STEER = 0
        STATE = "OBSTACLE"
        return
    if _obstacle:
        _obstacle = False
        STATE = "FOLLOW"
{% endif %}
    if _search:
        search_step(refl)
        return

    error = refl - EDGE
    if refl <= WHITE_ABOVE:
        _white_timer.reset()
    elif _white_timer.time() > LOST_MS:
        start_search(error)
        return

    if refl < BLACK_BELOW:
        STEER = correction_dir(error) * turn_rate(PIVOT_PER_MM)
        STATE = "PIVOT"
        light(Color.RED)
        robot.drive(0, STEER)
    else:
        STEER = KP * error + KD * (error - _last_error)
        STATE = "FOLLOW"
        light(Color.GREEN if refl > WHITE_ABOVE else Color.YELLOW)
        robot.drive(BASE_SPEED, STEER)
    _last_error = error
{% endblock %}
