{% extends "_base.py.j2" %}
{% block control %}
# Line follower, ported from the original hand-written script: PD on
# reflection around the calibrated edge, a sharp turn on black, and when the
# line is gone, sweep for it by angle, first toward the correction, then twice
# as far the other way. Calibration and the live check moved to the app.
# Blocking moves became steps of the base loop, so commands, the watchdog and
# telemetry keep running during a search.
#
# Wheels do not run backwards unless INNER_PCT is set below 0 (user request,
# 2026-09-24): pivoting in place and backing up looked like the robot
# reversing whenever it flipped between black and white. Every turn keeps the
# outer wheel at SPD and only slows the inner one. On full black or full white
# the inner wheel runs at INNER_PCT of SPD: the sharpest turn, back toward the
# edge. Below 0 the inner wheel runs backwards, for corners sharper than the
# arc allows (2026-09-26, the hairpin after the zigzag); -100 spins in place.
# PD steering in between never reverses a wheel. The search swings on the
# stopped inner wheel.
#
# Adaptive full turn (2026-09-26): one INNER could not serve both the 90
# degree green-wall corner (-25 was too sharp there) and the hairpin after the
# zigzag (-20 was not sharp enough). The full turn now starts at INNER_PCT and
# sharpens toward INNER_MIN_PCT over INNER_RAMP_MS while the sensor stays on
# full black or white turning the same way. A corner is done before it
# sharpens much; a hairpin keeps the sensor off the edge and gets the sharp
# turn. Back in the grey band for more than GRACE_MS, or turning the other
# way, starts it over at INNER_PCT.
#
# Full white turns as hard as full black (2026-09-25). The original only
# pivoted on black; on white the PD gave KP * error (73 deg/s against 102 on
# black at SPD 250), so the robot came back from white slower than it left
# black, and most LOST events in the recordings started right there.
#
# Route (protocol.md): planned steps in order, e.g. "RLLR" or "LRS". Before
# each turn the robot tracks the line edge on that side, so it takes that
# branch at the next junction; the gyro counts a turn as taken. S goes straight
# across a crossing: the gyro locks the heading within LOCK_DEG, so the edge
# cannot pull the robot into a branch. If a wall shows up while a turn is
# pending, the robot turns the planned way on the spot. With FINISH_MM above 0,
# the first line end at least that far after the last step is the finish.

from pybricks.parameters import Color

BLACK = {{ calibration.black }}
WHITE = {{ calibration.white }}
EDGE = {{ calibration.edge }}
BLACK_BELOW = (BLACK + EDGE) // 2  # original: nilai < (hitam + TEPI) / 2
WHITE_ABOVE = (WHITE + EDGE) // 2  # original: nilai > (putih + TEPI) / 2
# INNER_PCT and SEARCH_RATE live in the base template: INNER and SRCH change them.
AXLE_MM = {{ geometry.axle_track_mm }}
RAD_TO_DEG = 180 / math.pi
# White this long AND this far forward means the line is gone (90 degree
# corner, line end). Time alone was not enough: after a pivot the robot needs
# ~0.2-0.3 s to stop turning and swing back, so it sat on white for 150 ms
# right next to the line and searched every time (recorded 2026-09-24).
# Swinging back barely moves it forward; running off the line does.
LOST_MS = 150
LOST_MM = 30
# Search: a short first sweep toward the usual side (the correction the white
# asks for: a corner), then a long sweep back past the start (the side the
# robot was turning on black: a hairpin it cut through). One sensor cannot tell
# the two apart when the line is lost, so both are covered, the likely one
# first. The original swept 120 then 240, which drifted far the wrong way at a
# hairpin before coming back (2026-09-26).
SEARCH_FIRST_DEG = 45
SEARCH_BACK_DEG = 180  # the return sweep ends this far past the start heading

ROUTE = "{{ tuning.route }}"  # planned steps: L, R, S (straight); empty: plain following
TURN_DONE_DEG = 60  # heading change that counts as a planned turn taken
# The track is not square to the start heading: on 2026-09-26 the top line ran
# at +10 degrees, so an S lock of 12 around the ideal 0 left 2 degrees of room
# and the wall turn aimed 10 degrees off. The segment heading is learnt while
# the robot follows a line steadily (ANCHOR_RATE per loop), and the ideal
# heading after a turn is only the first guess.
SETTLE_DEG = 30  # on the new line: this close to the segment heading ...
STEADY_DEG = 6  # ... and turning less than this per 100 ms (straights swing ~5)
ANCHOR_RATE = 0.01  # per loop: ~1 s to learn the real line heading
ARM_MM = 100  # S arms after following the new line this far: the heading is learnt
# Wall fallback: turn on the spot to the planned heading, measured by the gyro,
# not by robot.turn(): with a wrong axle track, turn(90) did 64 degrees and left
# the sensor on white beside the branch (2026-09-26). If the sensor is then off
# the line, sweep back toward the old heading first: the wall stops the robot
# short of the junction, so the branch is ahead on that side. At the yellow
# wall the line showed up only 40-45 degrees into that sweep, so a 45 degree
# sweep found it by luck and missed it in other runs (2026-09-26): 90 degrees
# that way, then 45 past the start the other way.
WALL_TURN_RATE = 90  # deg/s, in place: the robot stands in front of the wall
WALL_TOL_DEG = 3
WALL_TURN_MS = 3000  # give up turning after this (wheels blocked)
WALL_SEARCH_FIRST_DEG = 90
WALL_SEARCH_BACK_DEG = 45
CROSS_MM = 30  # S: full black this far forward, heading locked, is the crossing

_last_error = 0
# KI term: error-seconds summed only in the grey edge band. It restarts on every
# full turn, search, wall or obstacle, where the error is large for reasons the
# integral must not learn from (windup), and is capped at INTEGRAL_MAX.
_integral = 0.0
INTEGRAL_MAX = 50
GRACE_MS = 80  # grey this long ends the current full turn's ramp
_full_dir = 0  # direction of the current full turn, 0 when none
_full_timer = StopWatch()  # how long the current full turn has lasted
_grey_timer = StopWatch()  # time since the last full-turn loop
_white_timer = StopWatch()
_white_from = 0  # robot.distance() when the sensor last left the line
_search = 0  # 0 following, 1 first sweep, 2 return sweep
_search_dir = 1
_sweep_start = 0
_obstacle = False
_wall_turn = False
_wall_sign = 1  # turn_sign of the planned step the wall turn makes
_wall_target = 0.0  # heading the wall turn ends at
_wall_timer = StopWatch()
_sweep_deg = SEARCH_FIRST_DEG  # first sweep of the current search
_back_deg = SEARCH_BACK_DEG  # the return sweep ends this far past the start
_wall_armed = True  # off after a wall turn until the distance reads clear again
_light = None
_step = 0  # planned turns taken
_side_step = 0  # the step whose turn side sets the tracked edge
_step_heading = 0.0  # ideal heading while the current step is pending
_finish_from = None  # robot.distance() when the last planned turn was taken
_black_from = None  # S: robot.distance() where the current full-black stretch began
_crossing = False  # S: on the crossing now; the step completes when it leaves it
_s_clear = True  # S: the sensor has left black since the edge switch; only then look for a crossing
_arm_from = 0  # S: robot.distance() at the last edge switch
_h_ref = 0.0  # heading 100 ms ago, for the steady test
_steady = False
_steady_timer = StopWatch()


def light(color):
    # Hub light per state, as in the original; only touched on change.
    global _light
    if color != _light:
        hub.light.on(color)
        _light = color


def turn_sign(c):
    return 1 if c == "R" else -1


def edge_flip():
    # 1 keeps the edge the KP sign tracks, -1 tracks the other one. Negative
    # KP tracks the right edge, and an edge follower takes that side's branch.
    # S keeps the KP edge: the heading lock, not the edge, carries it across.
    if not ROUTE:
        return 1
    step = ROUTE[min(_side_step, len(ROUTE) - 1)]
    if step == "S":
        return 1
    tuned = 1 if KP < 0 else -1
    return tuned * turn_sign(step)


def straight_pending():
    return _step < len(ROUTE) and ROUTE[_step] == "S"


def straight_armed():
    # The S lock and crossing detection start only once the robot has settled on
    # the new line and switched edge (2026-09-26: armed right after the R
    # corner at 30 degrees off, the lock blocked the way back to the line).
    ready = _side_step == _step and _s_clear and robot.distance() - _arm_from >= ARM_MM
    return straight_pending() and ready


def lock_heading(steer):
    # S pending: cut any steering that would turn further from the segment
    # heading than LOCK_DEG. The app frame is CCW-positive and a positive steer
    # turns right, which lowers the heading.
    off = _heading_deg - _step_heading
    if off >= LOCK_DEG and steer < 0:
        return 0
    if off <= -LOCK_DEG and steer > 0:
        return 0
    return steer


def step_taken():
    global _step, _finish_from
    _step += 1
    emit_e("TURN", "{}/{} {}".format(_step, len(ROUTE), ROUTE[_step - 1]))
    if _step == len(ROUTE):
        _finish_from = robot.distance()


def track_straight(refl):
    # S: a crossing is full black for CROSS_MM of forward travel while locked;
    # the step is taken once the sensor leaves it, and the lock goes with it.
    global _black_from, _crossing
    if refl < BLACK_BELOW:
        if _black_from is None:
            _black_from = robot.distance()
        elif robot.distance() - _black_from >= CROSS_MM:
            _crossing = True
        return
    _black_from = None
    if _crossing:
        _crossing = False
        step_taken()


def full_turn_inner(direction):
    # INNER_PCT when a full turn starts, sharpening to INNER_MIN_PCT over
    # INNER_RAMP_MS while it lasts, as a fraction (-1..1) for arc_turn().
    global _full_dir
    if direction != _full_dir or _grey_timer.time() > GRACE_MS:
        _full_dir = direction
        _full_timer.reset()
    _grey_timer.reset()
    if INNER_RAMP_MS <= 0:
        share = 1.0
    else:
        share = min(1.0, _full_timer.time() / INNER_RAMP_MS)
    return (INNER_PCT + (INNER_MIN_PCT - INNER_PCT) * share) / 100


def arc_turn(inner):
    # Turn rate (deg/s) with the outer wheel at BASE_SPEED and the inner one at
    # inner * BASE_SPEED, both forward. arc_turn(0): the inner wheel stops.
    return abs(BASE_SPEED) * (1 - inner) / AXLE_MM * RAD_TO_DEG


def arc_speed(turn_deg_s):
    # Centre speed when the outer wheel keeps BASE_SPEED and only the inner
    # wheel slows down to make turn_deg_s.
    return BASE_SPEED - abs(turn_deg_s) / RAD_TO_DEG * AXLE_MM / 2


def swing_speed(turn_deg_s):
    # Centre speed that turns at turn_deg_s on a stopped inner wheel.
    return abs(turn_deg_s) / RAD_TO_DEG * AXLE_MM / 2


def correction_dir(error):
    # Turn direction of the correction; follows the sign of KP and the edge.
    return edge_flip() if KP * error > 0 else -edge_flip()


def reset_integral():
    global _integral
    _integral = 0.0


def on_line():
    # The sensor sees the line (or its edge): restart the lost clocks.
    global _white_from
    _white_timer.reset()
    _white_from = robot.distance()


def setup():
    global STATE, _step_heading, _arm_from
    STATE = "FOLLOW"
    on_line()
    _step_heading = _heading_deg
    _arm_from = robot.distance()


def track_route(refl):
    # Edge switch: only once settled on the new line AND with the sensor on full
    # black. From black, the new edge's control carries the sensor across the
    # tape to the new side. Switching on white put the sensor on the wrong side:
    # the new edge's control then turned away from the line (2026-09-26).
    global _side_step, _step_heading, _s_clear, _arm_from, _h_ref, _steady
    if _steady_timer.time() >= 100:
        _steady = abs(_heading_deg - _h_ref) < STEADY_DEG
        _h_ref = _heading_deg
        _steady_timer.reset()
    near = abs(_heading_deg - _step_heading) < SETTLE_DEG
    if near and _steady and _side_step == _step:
        # following this segment steadily: learn its real heading
        _step_heading += ANCHOR_RATE * (_heading_deg - _step_heading)
    if _side_step < _step and near and _steady and refl < BLACK_BELOW:
        _side_step = _step
        _s_clear = False  # crossing the tape now is the switch, not a crossing
        _arm_from = robot.distance()
    if _step >= len(ROUTE):
        return
    if ROUTE[_step] == "S":
        if _side_step == _step and not _s_clear and refl >= BLACK_BELOW:
            _s_clear = True
        if straight_armed():
            track_straight(refl)  # straight on: the ideal heading stays
        return
    sign = turn_sign(ROUTE[_step])
    # the app frame is CCW-positive: a right turn lowers the heading
    if (_step_heading - _heading_deg) * sign >= TURN_DONE_DEG:
        _step_heading -= sign * 90
        step_taken()


def finish_reached():
    # Opt-in: FINISH_MM 0 turns it off, so a line end is always searched.
    if FINISH_MM <= 0 or _finish_from is None:
        return False
    return robot.distance() - _finish_from >= FINISH_MM


def finish():
    global STATE, STEER, STOPPED
    robot.stop()
    STEER = 0
    STATE = "STOP"
    emit_e("FINISH", int(robot.distance() - _finish_from))
    light(Color.GREEN)
    beep(800, 300)
    STOPPED = True


def start_search(error, direction=None, first_deg=SEARCH_FIRST_DEG, back_deg=SEARCH_BACK_DEG):
    # Sweeps are measured by the gyro heading, which the axle track cannot skew.
    global STATE, STEER, _search, _search_dir, _sweep_start, _sweep_deg, _back_deg
    _search_dir = correction_dir(error) if direction is None else direction
    _sweep_deg = first_deg
    _back_deg = back_deg
    _search = 1
    reset_integral()
    _sweep_start = _heading_deg
    STATE = "SEARCH"
    STEER = 0
    light(Color.BLUE)
    emit_e("LOST")


def search_step(refl):
    global STATE, STEER, STOPPED, _search, _search_dir, _sweep_start, _last_error
    if refl < EDGE:
        robot.stop()
        _search = 0
        _last_error = 0
        on_line()
        STATE = "FOLLOW"
        emit_e("FOUND")
        return
    limit = _sweep_deg if _search == 1 else _sweep_deg + _back_deg
    if abs(_heading_deg - _sweep_start) >= limit:
        robot.stop()
        if _search == 1:
            _search = 2
            _search_dir = -_search_dir
            _sweep_start = _heading_deg
        else:
            STEER = 0
            STATE = "STOP"
            emit_e("GIVEUP")
            beep(400, 500)
            STOPPED = True
            return
    STEER = _search_dir * SEARCH_RATE
    robot.drive(swing_speed(SEARCH_RATE), STEER)  # swing forward, never back


def start_wall_turn():
    global STATE, STEER, _wall_turn, _wall_sign, _wall_target
    _wall_sign = turn_sign(ROUTE[_step])
    _wall_target = _step_heading - _wall_sign * 90  # CCW frame: right lowers it
    _wall_timer.reset()
    _wall_turn = True
    STATE = "WALL"
    STEER = 0


def wall_turn_step():
    # True once the gyro heading reached the target (or the turn timed out).
    global STEER
    remaining = (_wall_target - _heading_deg) * -_wall_sign
    if remaining <= WALL_TOL_DEG or _wall_timer.time() > WALL_TURN_MS:
        robot.stop()
        STEER = 0
        return True
    STEER = _wall_sign * WALL_TURN_RATE
    robot.drive(0, STEER)
    return False


def control_step(n, refl):
    global STATE, STEER, _last_error, _obstacle, _search, _wall_turn, _wall_armed, _integral
    if _wall_turn:
        if not wall_turn_step():
            return
        _wall_turn = False  # facing the planned branch; follow or search from here
        track_route(refl)  # the planned step is taken
        on_line()
        STATE = "FOLLOW"
        if refl > WHITE_ABOVE:
            start_search(0, -_wall_sign, WALL_SEARCH_FIRST_DEG, WALL_SEARCH_BACK_DEG)
            return
    if not _search:
        track_route(refl)
{% if distance %}
    if _distance_mm >= OBSTACLE_MM:
        _wall_armed = True
    elif _wall_armed:
        reset_integral()
        if not _obstacle:
            _obstacle = True
            emit_e("OBS", _distance_mm)
            light(Color.MAGENTA)
            beep(1000, 100)
        robot.stop()
        STEER = 0
        if _step < len(ROUTE) and not straight_pending():
            # the branch was missed: turn the planned way on the spot
            _search = 0
            _wall_armed = False  # the same wall may still be in view after the turn
            start_wall_turn()
            return
        STATE = "OBSTACLE"
        return
    if _obstacle:
        _obstacle = False
        if not _search:
            STATE = "FOLLOW"  # a search after a wall turn keeps its SEARCH state
{% endif %}
    if _search:
        search_step(refl)
        return

    error = refl - EDGE
    if refl <= WHITE_ABOVE:
        on_line()
    elif _white_timer.time() > LOST_MS and robot.distance() - _white_from >= LOST_MM:
        if finish_reached():
            finish()
            return
        start_search(error)
        return

    if refl < BLACK_BELOW or refl > WHITE_ABOVE:
        # off the edge on either side: a full arc back toward it, sharpening
        # the longer it lasts (INNER_PCT -> INNER_MIN_PCT)
        direction = correction_dir(error)
        STEER = direction * arc_turn(full_turn_inner(direction))
        STATE = "PIVOT"
        light(Color.RED if refl < BLACK_BELOW else Color.GREEN)
        reset_integral()
    else:
        _integral = max(-INTEGRAL_MAX, min(INTEGRAL_MAX, _integral + error * LOOP_MS / 1000))
        STEER = edge_flip() * (KP * error + KI * _integral + KD * (error - _last_error))
        # never sharper than the full turn, and never with a wheel backwards
        limit = arc_turn(max(0.0, INNER_PCT) / 100)
        STEER = max(-limit, min(limit, STEER))
        STATE = "FOLLOW"
        light(Color.YELLOW)
    if straight_armed():
        STEER = lock_heading(STEER)
    robot.drive(arc_speed(STEER), STEER)  # outer wheel at SPD, only the inner one slows
    _last_error = error
{% endblock %}
