from pybricks.hubs import InventorHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import ColorSensor, Motor, UltrasonicSensor
from pybricks.robotics import DriveBase
from pybricks.tools import StopWatch, wait
from uselect import poll
import umath as math
import usys

PROTO_VERSION = {{ proto_version }}
MODE = "{{ mode | upper }}"
LOOP_MS = {{ loop_ms }}
WATCHDOG_MS = {{ watchdog_ms }}
T_EVERY = {{ t_every }}
DISTANCE_EVERY = {{ distance_every }}

# -- devices: only what the config assigns (an empty port raises OSError) --

hub = InventorHub()
left_motor = Motor(Port.{{ left.port }}, Direction.{{ left.direction }})
right_motor = Motor(Port.{{ right.port }}, Direction.{{ right.direction }})
robot = DriveBase(
    left_motor,
    right_motor,
    wheel_diameter={{ geometry.wheel_diameter_mm }},
    axle_track={{ geometry.axle_track_mm }},
)
robot.use_gyro(True)
{% if line %}
line_sensor = ColorSensor(Port.{{ line.port }})
{% endif %}
{% if distance %}
distance_sensor = UltrasonicSensor(Port.{{ distance.port }})
{% endif %}

# -- tuning, changed live by commands --

KP = {{ tuning.kp }}
KD = {{ tuning.kd }}
BASE_SPEED = {{ tuning.base_speed_mm_s }}
OBSTACLE_MM = {{ tuning.obstacle_threshold_mm }}

STOPPED = False
PAUSED = False
STATE = "IDLE"
STEER = 0

clock = StopWatch()
_last_rx = StopWatch()  # watchdog clock: reset by every command received
_poll = poll()
_poll.register(usys.stdin)

# -- odometry: x forward, y left, heading CCW from x, origin at run start --

_x = 0.0
_y = 0.0
_heading_deg = 0.0
_last_distance = 0
_distance_mm = 2000


def read_heading_deg():
    # Pybricks heading grows clockwise; the app frame is CCW-positive.
    # VERIFY on hardware: a left turn must increase heading on the map.
    return -hub.imu.heading()


def reset_origin():
    global _x, _y, _heading_deg, _last_distance
    _x = 0.0
    _y = 0.0
    hub.imu.reset_heading(0)
    _heading_deg = 0.0
    _last_distance = robot.distance()


def update_pose():
    global _x, _y, _heading_deg, _last_distance
    distance = robot.distance()
    _heading_deg = read_heading_deg()
    heading = math.radians(_heading_deg)
    delta = distance - _last_distance
    _last_distance = distance
    _x += delta * math.cos(heading)
    _y += delta * math.sin(heading)


def read_reflection():
{% if line %}
    return line_sensor.reflection()
{% else %}
    return 0
{% endif %}


def update_distance(n):
    global _distance_mm
{% if distance %}
    if n % DISTANCE_EVERY == 0:
        _distance_mm = distance_sensor.distance()
{% else %}
    pass
{% endif %}


# -- telemetry --


def emit_t(refl):
    print(
        "T,{},{:.1f},{:.1f},{:.1f},{},{},{}".format(
            clock.time(), _x, _y, _heading_deg, refl, int(STEER), STATE
        )
    )


def emit_e(kind, detail=None):
    if detail is None:
        print("E,{},{},{:.1f},{:.1f}".format(kind, clock.time(), _x, _y))
    else:
        print("E,{},{},{:.1f},{:.1f},{}".format(kind, clock.time(), _x, _y, detail))


# -- commands: non-blocking stdin poll, never wait inside the loop --


def check_commands():
    global KP, KD, BASE_SPEED, OBSTACLE_MM, STOPPED, PAUSED
    while _poll.poll(0):
        line = usys.stdin.readline().strip()
        if not line:
            break
        _last_rx.reset()
        key, _, value = line.partition(",")
        try:
            if key == "KP":
                KP = float(value)
            elif key == "KD":
                KD = float(value)
            elif key == "SPD":
                BASE_SPEED = float(value)
            elif key == "THR":
                OBSTACLE_MM = int(value)
            elif key == "MODE":
                if value == "STOP":
                    STOPPED = True
                elif value == "PAUSE":
                    PAUSED = True
                elif value == "RESUME":
                    PAUSED = False
            elif key == "ORG":
                reset_origin()
        except ValueError:
            pass  # malformed value: ignore the command, keep driving safely


def watchdog_ok():
    return _last_rx.time() <= WATCHDOG_MS


# -- mode --
{% block control %}{% endblock %}


# -- main loop --


def main():
    global STATE, STEER
    print("R,{},{}".format(MODE, PROTO_VERSION))
    reset_origin()
    setup()
    loop_timer = StopWatch()
    refl = read_reflection()
    n = 0
    while True:
        loop_timer.reset()
        check_commands()
        if STOPPED:
            break
        if not watchdog_ok():
            robot.stop()
            STEER = 0
            STATE = "STOP"
            emit_e("WDOG", _last_rx.time())
            break
        update_pose()
        update_distance(n)
        refl = read_reflection()
        if PAUSED:
            robot.stop()
            STEER = 0
            STATE = "IDLE"
        else:
            control_step(n, refl)
        n += 1
        if n % T_EVERY == 0:
            emit_t(refl)
        spare = LOOP_MS - loop_timer.time()
        if spare > 0:
            wait(spare)
    robot.stop()
    STEER = 0
    STATE = "STOP"
    emit_t(refl)


main()
