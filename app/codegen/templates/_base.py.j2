# Every mode extends this file. It owns devices, odometry, telemetry, the
# stdin command poll and the watchdog. A mode only supplies setup() and
# control_step(n, refl), and must not redefine anything below.

from pybricks.hubs import InventorHub
from pybricks.parameters import Direction, Port
from pybricks.pupdevices import ColorSensor, Motor, UltrasonicSensor
from pybricks.robotics import DriveBase
from pybricks.tools import StopWatch, wait
from uselect import poll
import umath as math
import usys

PROTO_VERSION = {{ proto_version }}
MODE = "{{ mode | upper }}"
LOOP_MS = {{ loop_ms }}
WATCHDOG_MS = {{ watchdog_ms }}
T_EVERY = {{ t_every }}
S_EVERY = {{ s_every }}
D_EVERY = {{ d_every }}
IMU_WAIT_S_MS = 500
BUMP_MM_S2 = 15000  # horizontal acceleration spike, ~1.5 g: likely a collision
BUMP_COOLDOWN_MS = 500
DISTANCE_EVERY = {{ distance_every }}
BEEP_MAX_MS = {{ beep_max_ms }}  # BEEP blocks the loop while it plays
SOUND = {{ "True" if sound else "False" }}  # the app's speaker button, fixed at Run

# -- devices: only what the config assigns (an empty port raises OSError) --

hub = InventorHub()
left_motor = Motor(Port.{{ left.port }}, Direction.{{ left.direction }})
right_motor = Motor(Port.{{ right.port }}, Direction.{{ right.direction }})
robot = DriveBase(
    left_motor,
    right_motor,
    wheel_diameter={{ geometry.wheel_diameter_mm }},
    axle_track={{ geometry.axle_track_mm }},
)
{% if use_gyro %}
robot.use_gyro(True)
{% else %}
robot.use_gyro(False)  # line follower: steering lag; turn drift test: measures the wheels
{% endif %}
{% if line %}
line_sensor = ColorSensor(Port.{{ line.port }})
{% endif %}
{% if distance %}
distance_sensor = UltrasonicSensor(Port.{{ distance.port }})
{% endif %}

# -- tuning, changed live by commands --

KP = {{ tuning.kp }}
KI = {{ tuning.ki }}
KD = {{ tuning.kd }}
BASE_SPEED = {{ tuning.base_speed_mm_s }}
OBSTACLE_MM = {{ tuning.obstacle_threshold_mm }}
INNER_PCT = {{ tuning.inner_pct }}  # line follower full turn as it starts: inner wheel % of outer
INNER_MIN_PCT = {{ tuning.inner_min_pct }}  # ... the sharpest it gets while the sensor stays off the edge
INNER_RAMP_MS = {{ tuning.inner_ramp_ms }}  # ... and how long that takes
SEARCH_RATE = {{ tuning.search_deg_s }}  # deg/s, line follower sweep for a lost line
FINISH_MM = {{ tuning.finish_mm }}  # line follower: route end to finish, minimum mm
LOCK_DEG = {{ tuning.route_lock_deg }}  # line follower, route step S: heading lock

# teleop setpoint (protocol.md, DRV); only teleop.py.j2 drives from it
DRV_MAX_SPEED = {{ max_speed }}
DRV_MAX_TURN = {{ max_turn }}
DRV_SPEED = 0
DRV_TURN = 0
_drv_timer = StopWatch()

STOPPED = False
PAUSED = False
STATE = "IDLE"
STEER = 0

clock = StopWatch()
_last_rx = StopWatch()  # watchdog clock: reset by every command received
_poll = poll()
_poll.register(usys.stdin)

# -- odometry: x forward, y left, heading CCW from x, origin at run start --

_x = 0.0
_y = 0.0
_heading_deg = 0.0
_last_distance = 0
_distance_mm = 2000


def read_heading_deg():
    # Pybricks heading grows clockwise; the app frame is CCW-positive.
    # VERIFY on hardware: a left turn must increase heading on the map.
    return -hub.imu.heading()


def reset_origin():
    global _x, _y, _heading_deg, _last_distance
    _x = 0.0
    _y = 0.0
    hub.imu.reset_heading(0)
    _heading_deg = 0.0
    _last_distance = robot.distance()


def update_pose():
    global _x, _y, _heading_deg, _last_distance
    distance = robot.distance()
    _heading_deg = read_heading_deg()
    heading = math.radians(_heading_deg)
    delta = distance - _last_distance
    _last_distance = distance
    _x += delta * math.cos(heading)
    _y += delta * math.sin(heading)


def read_reflection():
{% if line %}
    return line_sensor.reflection()
{% else %}
    return 0
{% endif %}


def update_distance(n):
    global _distance_mm
{% if distance %}
    if n % DISTANCE_EVERY == 0:
        _distance_mm = distance_sensor.distance()
{% else %}
    pass
{% endif %}


# -- telemetry --


def emit_t(refl):
    print(
        "T,{},{:.1f},{:.1f},{:.1f},{},{},{}".format(
            clock.time(), _x, _y, _heading_deg, refl, int(STEER), STATE
        )
    )


def emit_d(dt_ms):
    # Slow detail at 4 Hz: hsv() and load() are the expensive reads, so they
    # happen only here (hub-programs.md, loop time budget).
{% if line %}
    c = line_sensor.hsv()
    h, s, v = c.h, c.s, c.v
{% else %}
    h, s, v = 0, 0, 0
{% endif %}
    print(
        "D,{},{},{},{},{},{},{}".format(
            clock.time(), h, s, v, left_motor.load(), right_motor.load(), dt_ms
        )
    )


def emit_s():
    print(
        "S,{},{},{},{}".format(
            clock.time(),
            hub.battery.voltage(),
            hub.battery.current(),
            1 if hub.imu.ready() else 0,
        )
    )


def beep(hz, ms):
    # Every hub sound goes through here, so the speaker button mutes them all.
    if SOUND:
        hub.speaker.beep(hz, ms)


def emit_e(kind, detail=None):
    if detail is None:
        print("E,{},{},{:.1f},{:.1f}".format(kind, clock.time(), _x, _y))
    else:
        print("E,{},{},{:.1f},{:.1f},{}".format(kind, clock.time(), _x, _y, detail))


# -- events detected on the hub --

_stalled_left = False
_stalled_right = False
_bump_timer = StopWatch()


def check_stall():
    # One STALL per onset, not one per loop while it lasts.
    global _stalled_left, _stalled_right
    left = left_motor.stalled()
    right = right_motor.stalled()
    if left and not _stalled_left:
        emit_e("STALL", "L")
    if right and not _stalled_right:
        emit_e("STALL", "R")
    _stalled_left = left
    _stalled_right = right


def check_bump():
    a = hub.imu.acceleration()
    peak = int(math.sqrt(a[0] * a[0] + a[1] * a[1]))  # horizontal only: gravity is z
    if peak > BUMP_MM_S2 and _bump_timer.time() > BUMP_COOLDOWN_MS:
        emit_e("BUMP", peak)
        _bump_timer.reset()


# -- commands: non-blocking stdin poll, never wait inside the loop --


def split_once(text):
    # "KP,-1.5" -> ("KP", "-1.5"). Pybricks MicroPython has no str.partition.
    i = text.find(",")
    if i < 0:
        return text, ""
    return text[:i], text[i + 1 :]


def check_commands():
    global KP, KI, KD, BASE_SPEED, OBSTACLE_MM, INNER_PCT, SEARCH_RATE, FINISH_MM, LOCK_DEG
    global INNER_MIN_PCT, INNER_RAMP_MS
    global STOPPED, PAUSED, DRV_SPEED, DRV_TURN
    while _poll.poll(0):
        line = usys.stdin.readline().strip()
        if not line:
            break
        _last_rx.reset()
        key, value = split_once(line)
        try:
            if key == "KP":
                KP = float(value)
                emit_e("ACK", "KP:{}".format(KP))
            elif key == "KI":
                KI = float(value)
                emit_e("ACK", "KI:{}".format(KI))
            elif key == "KD":
                KD = float(value)
                emit_e("ACK", "KD:{}".format(KD))
            elif key == "SPD":
                BASE_SPEED = float(value)
                emit_e("ACK", "SPD:{}".format(BASE_SPEED))
            elif key == "IMIN":
                INNER_MIN_PCT = max(-100.0, min(100.0, float(value)))
                emit_e("ACK", "IMIN:{}".format(INNER_MIN_PCT))
            elif key == "RAMP":
                INNER_RAMP_MS = max(0.0, min(3000.0, float(value)))
                emit_e("ACK", "RAMP:{}".format(INNER_RAMP_MS))
            elif key == "INNER":
                INNER_PCT = max(-100.0, min(100.0, float(value)))
                emit_e("ACK", "INNER:{}".format(INNER_PCT))
            elif key == "SRCH":
                SEARCH_RATE = max(0.0, min(DRV_MAX_TURN, float(value)))
                emit_e("ACK", "SRCH:{}".format(SEARCH_RATE))
            elif key == "FIN":
                FINISH_MM = max(0.0, float(value))
                emit_e("ACK", "FIN:{}".format(FINISH_MM))
            elif key == "LOCK":
                LOCK_DEG = max(5.0, min(60.0, float(value)))
                emit_e("ACK", "LOCK:{}".format(LOCK_DEG))
            elif key == "THR":
                OBSTACLE_MM = int(value)
                emit_e("ACK", "THR:{}".format(OBSTACLE_MM))
            elif key == "MODE":
                if value == "STOP":
                    STOPPED = True
                elif value == "PAUSE":
                    PAUSED = True
                elif value == "RESUME":
                    PAUSED = False
            elif key == "ORG":
                reset_origin()
            elif key == "BEEP":
                hz, ms = split_once(value)
                beep(int(hz), max(0, min(BEEP_MAX_MS, int(ms))))
            elif key == "DRV":
                speed, turn = split_once(value)
                DRV_SPEED = max(-DRV_MAX_SPEED, min(DRV_MAX_SPEED, float(speed)))
                DRV_TURN = max(-DRV_MAX_TURN, min(DRV_MAX_TURN, float(turn)))
                _drv_timer.reset()
        except ValueError:
            pass  # malformed value: no ACK, keep the old value, keep driving safely


def watchdog_ok():
    return _last_rx.time() <= WATCHDOG_MS


def trip_watchdog():
    # The only place WDOG is emitted; callers leave their loop right after.
    global STATE, STEER
    robot.stop()
    STEER = 0
    STATE = "STOP"
    emit_e("WDOG", _last_rx.time())


def wait_for_imu():
    # Heading is meaningless until the IMU settles. Hold still, keep serving
    # commands and the watchdog, report S with imu_ready=0. False: give up.
    timer = StopWatch()
    while not hub.imu.ready():
        check_commands()
        if STOPPED:
            return False
        if not watchdog_ok():
            trip_watchdog()
            return False
        if timer.time() >= IMU_WAIT_S_MS:
            emit_s()
            timer.reset()
        wait(LOOP_MS)
    emit_s()
    return True


# -- mode --
{% block control %}{% endblock %}


# -- main loop --


def main():
    global STATE, STEER
    print("R,{},{}".format(MODE, PROTO_VERSION))
{% for hz, ms in run_tones %}
    beep({{ hz }}, {{ ms }})  # started (app/core/beeps.py, "run")
{% endfor %}
    refl = read_reflection()
    if wait_for_imu():
        reset_origin()
        setup()
        refl = run_loop()
    robot.stop()
    STEER = 0
    STATE = "STOP"
    emit_t(refl)


def run_loop():
    global STATE, STEER
    loop_timer = StopWatch()
    period = StopWatch()  # full iteration including the wait: the real loop dt
    dt_ms = LOOP_MS
    refl = read_reflection()
    n = 0
    while True:
        dt_ms = period.time()
        period.reset()
        loop_timer.reset()
        check_commands()
        if STOPPED:
            break
        if not watchdog_ok():
            trip_watchdog()
            break
        update_pose()
        update_distance(n)
        refl = read_reflection()
        if PAUSED:
            robot.stop()
            STEER = 0
            STATE = "IDLE"
        else:
            control_step(n, refl)
        n += 1
        if n % T_EVERY == 0:
            emit_t(refl)
            check_bump()
        if n % D_EVERY == 0:
            emit_d(dt_ms)
            check_stall()
        if n % S_EVERY == 0:
            emit_s()
        spare = LOOP_MS - loop_timer.time()
        if spare > 0:
            wait(spare)
    return refl


main()
